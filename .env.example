# ==============================================================================
# Florian Portfolio — Environment Variables Template
# Kopiere diese Datei nach `.env.local` und trage deine echten Werte ein.
# ==============================================================================

# 1. Kontaktformular (Pflicht für den E-Mail-Versand via Resend)
# API-Key aus dem Resend Dashboard (https://resend.com/api-keys)
RESEND_API_KEY=

# Absender-Adresse (WICHTIG: Resend blockiert Freemail-Domains wie @yahoo.de,
# @icloud.com oder @gmail.com als Absender!).
# Ohne eigene verifizierte Domain zwingend `onboarding@resend.dev` verwenden:
CONTACT_FROM_EMAIL="Portfolio Dispatch <onboarding@resend.dev>"

# Empfänger-Adresse (Optional — Standard ist SITE_CONFIG.owner.email).
# Hinweis für den Resend-Testmodus mit `onboarding@resend.dev`:
# Hier muss exakt die E-Mail-Adresse stehen, mit der dein Resend-Konto registriert ist!
CONTACT_TO_EMAIL=

# 2. GitHub Live Telemetry (Optional, aber empfohlen für 5.000 Req/h statt 60 Req/h)
# Fine-grained Personal Access Token mit Public Repositories (read-only)
GITHUB_TOKEN=

# 3. Canonical Site URL (Optional — auf Vercel automatisch über VERCEL_PROJECT_PRODUCTION_URL gesetzt)
# Für eigene Custom-Domain z. B. https://deine-domain.de setzen:
NEXT_PUBLIC_SITE_URL=
